# Загрузка видео до 50 МБ, если PHP работает модулем Apache (иначе действует api/.user.ini)
<IfModule mod_php.c>
  php_value upload_max_filesize 60M
  php_value post_max_size 64M
  php_value max_execution_time 300
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 60M
  php_value post_max_size 64M
  php_value max_execution_time 300
</IfModule>
